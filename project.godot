; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Темный Бог Надувных Замков"
config/description="3D физический прототип на Godot Engine 4.7.2 (Jolt Physics + Godot Aerodynamic Physics 0.9.1) для Android: процедурная долина, 33-метровый летающий надувной замок НЗТБНЗ, Ragdoll и сенсорное управление."
config/version="1.0.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://resources/default_bus_layout.tres"

[autoload]

AeroUnits="*res://addons/godot_aerodynamic_physics/core/singletons/aero_units.gd"
GameState="*res://scripts/autoload/game_state.gd"
WindManager="*res://scripts/autoload/wind_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_aerodynamic_physics/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/android/enable_pan_and_scale_gestures=false

[layer_names]

3d_physics/layer_1="WorldTerrain"
3d_physics/layer_2="Player"
3d_physics/layer_3="InflatableCastle"
3d_physics/layer_4="DarkGodAndProps"
3d_physics/layer_5="ClimbableRopes"
3d_physics/layer_6="PlayerRagdoll"
3d_physics/layer_7="TriggersAndWind"
3d_physics/layer_15="Atmosphere Areas"

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=9.8
3d/default_linear_damp=0.0
3d/default_angular_damp=0.0
common/physics_ticks_per_second=60
aerodynamics/substeps=2
aerodynamics/atmosphere_area_collision_layer=15

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.03, 0.035, 0.07, 1)
